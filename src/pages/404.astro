---
import Layout from "../components/Layout.astro";
---

<Layout title="Página no encontrada" flush>
  <div class="notfound">
    <div class="wrap">
      <p class="flag">Error 404</p>
      <h1>Se quemó en el horno</h1>
      <p class="msg">No encontramos esta receta. Puede que haya cambiado de lugar.</p>
      <a href="/" class="link back">← Volver a las recetas</a>
    </div>
  </div>
</Layout>

<style>
  .notfound {
    background-color: var(--aji);
    color: var(--paper);
    padding-block: 56px 72px;
  }
  .flag {
    background-color: var(--amarillo);
    color: var(--ink);
    display: inline-block;
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-stretch: 100%;
    font-weight: 800;
    letter-spacing: 0.08em;
    padding: 5px 10px;
    text-transform: uppercase;
  }
  h1 {
    font-size: clamp(3.5rem, 13vw, 11rem);
    font-stretch: 62%;
    font-weight: 900;
    letter-spacing: -0.03em;
    line-height: 0.86;
    margin-block: 12px 24px;
    max-width: 12ch;
    text-transform: uppercase;
  }
  .msg {
    font-size: 1.375rem;
    margin-bottom: 28px;
  }
  .back {
    background-color: var(--paper);
    color: var(--ink);
    display: inline-block;
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-stretch: 100%;
    font-weight: 800;
    letter-spacing: 0.08em;
    padding: 14px 22px;
    text-transform: uppercase;
  }
  .back:focus-visible {
    outline-color: var(--ink);
    outline-offset: 4px;
  }
  .back:hover {
    background-color: var(--amarillo);
  }
</style>
