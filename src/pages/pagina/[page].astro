---
import Layout from "../../components/Layout.astro";
import RecipeGrid from "../../components/RecipeGrid.astro";
import Pagination from "../../components/Pagination.astro";
import SearchTrigger from "../../components/SearchTrigger.astro";
import { getAllRecetas, getCategorias } from "../../lib/content";
import { paginate, sortedRecetas, PER_PAGE } from "../../lib/paginate";

export async function getStaticPaths() {
  const all = sortedRecetas(await getAllRecetas());
  const total = Math.max(1, Math.ceil(all.length / PER_PAGE));
  // Page 1 is the homepage ("/"); /pagina/1 must not exist as a duplicate.
  return Array.from({ length: total - 1 }, (_, i) => ({ params: { page: String(i + 2) } }));
}

const { page } = Astro.params;
const pageNumber = Number(page);
const all = sortedRecetas(await getAllRecetas());
const { items: recetas, current, total } = paginate(all, pageNumber);
// Static builds only generate in-range pages; this guards against the
// clamp inside paginate() ever silently rendering a wrong page
// (e.g. if this route is ever served dynamically — return a real 404 there).
if (!Number.isInteger(pageNumber) || pageNumber < 2 || pageNumber > total) {
  throw new Error(`/pagina/${page} is out of range (total ${total}) — must 404, not render`);
}
const deptNames = new Map((await getCategorias()).map(({ slug, categoria }) => [slug, categoria?.nombre ?? slug]));
---

<Layout title={current <= 1 ? "BonGusto" : `Recetas — página ${current}`}>
  <div class="wrap">
    <header class="page-head">
      <p class="kicker">Página {current} de {total}</p>
      <h1>Todas las recetas</h1>
      <div class="search"><SearchTrigger /></div>
    </header>
    <RecipeGrid recetas={recetas} deptNames={deptNames} eager={2} heading="Recetas de esta página" />
    <Pagination current={current} total={total} />
  </div>
</Layout>

<style>
  .page-head {
    align-items: end;
    display: flex;
    flex-wrap: wrap;
    gap: 12px 32px;
    justify-content: space-between;
    padding-block: 48px 40px;
  }
  .page-head .kicker {
    flex-basis: 100%;
  }
  h1 {
    font-size: clamp(3rem, 9vw, 8rem);
    font-stretch: 62%;
    font-weight: 900;
    text-transform: uppercase;
  }
  .search {
    flex: 0 1 26rem;
    min-width: 240px;
  }
</style>
