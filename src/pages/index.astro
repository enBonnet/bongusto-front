---
import Layout from "../components/Layout.astro";
import Cover from "../components/Cover.astro";
import RecipeGrid from "../components/RecipeGrid.astro";
import Pagination from "../components/Pagination.astro";
import SearchTrigger from "../components/SearchTrigger.astro";
import SectionHead from "../components/SectionHead.astro";
import { getAllRecetas, getCategorias } from "../lib/content";
import { paginate, sortedRecetas } from "../lib/paginate";

const all = sortedRecetas(await getAllRecetas());
const { items: recetas, current, total } = paginate(all, 1);
const deptNames = new Map((await getCategorias()).map(({ slug, categoria }) => [slug, categoria?.nombre ?? slug]));
// Newest recipe is the cover; the grid shows the rest of the page. The cover
// is not repeated in the grid (its view-transition-name must stay unique).
const [cover, ...rest] = recetas;
---

<Layout title="BonGusto">
  <h1 class="sr-only">BonGusto — recetas con un poco de historia</h1>
  {
    cover ? (
      <>
        <Cover receta={cover} dept={deptNames.get((cover.categorias ?? [])[0] ?? "")} />
        <div class="wrap">
          <SectionHead title="Más recetas">
            <SearchTrigger />
          </SectionHead>
          <RecipeGrid recetas={rest} deptNames={deptNames} eager={2} />
          <Pagination current={current} total={total} />
        </div>
      </>
    ) : (
      <p class="wrap empty">Aún no hay recetas cargadas</p>
    )
  }
</Layout>

<style>
  .empty {
    padding-block: 64px;
  }
</style>
