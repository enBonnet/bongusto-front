---
import Layout from "../../../components/Layout.astro";
import DeptBanner from "../../../components/DeptBanner.astro";
import RecipeGrid from "../../../components/RecipeGrid.astro";
import Pagination from "../../../components/Pagination.astro";
import { getCategorias, getRecetasByCategoria } from "../../../lib/content";
import { PER_PAGE } from "../../../lib/paginate";

export async function getStaticPaths() {
  const categorias = await getCategorias();
  const paths: { params: { slug: string; page: string } }[] = [];
  for (const { slug } of categorias) {
    const all = await getRecetasByCategoria(slug);
    const total = Math.ceil(all.length / PER_PAGE);
    for (let p = 2; p <= total; p++) paths.push({ params: { slug, page: String(p) } });
  }
  return paths;
}

const { slug, page } = Astro.params;
const all = await getRecetasByCategoria(slug!);
const total = Math.max(1, Math.ceil(all.length / PER_PAGE));
const current = Number(page);
// Static builds only generate pages 2..total; fail loudly instead of
// clamping an out-of-range request to a wrong page (return a real 404
// if this route is ever served dynamically).
if (!Number.isInteger(current) || current < 2 || current > total) {
  throw new Error(`/categoria/${slug}/${page} is out of range (total ${total}) — must 404, not render`);
}
const recetas = all.slice((current - 1) * PER_PAGE, current * PER_PAGE);
const categorias = await getCategorias();
const cat = categorias.find((c) => c.slug === slug);
const nombre = cat?.categoria?.nombre ?? slug!;
const deptNames = new Map(categorias.map(({ slug: s, categoria }) => [s, categoria?.nombre ?? s]));
---

<Layout title={`${nombre} — página ${current}`}>
  <DeptBanner nombre={nombre} count={all.length} page={{ current, total }} />
  <div class="wrap">
    <div class="grid-wrap">
      <RecipeGrid recetas={recetas} deptNames={deptNames} eager={2} heading="Recetas de esta sección" />
    </div>
    <Pagination current={current} total={total} makeHref={(n) => (n <= 1 ? `/categoria/${slug}` : `/categoria/${slug}/${n}`)} />
  </div>
</Layout>

<style>
  .grid-wrap {
    padding-top: 56px;
  }
</style>
