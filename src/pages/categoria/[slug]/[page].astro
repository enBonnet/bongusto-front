---
import Layout from "../../../components/Layout.astro";
import Card from "../../../components/Card.astro";
import Pagination from "../../../components/Pagination.astro";
import { getAllRecetas, getCategorias } from "../../../lib/content.js";
import { PER_PAGE } from "../../../lib/paginate.js";

export async function getStaticPaths() {
  const categorias = await getCategorias();
  const paths: { params: { slug: string; page: string } }[] = [];
  for (const { slug } of categorias) {
    const all = (await getAllRecetas()).filter((r) => (r.categorias ?? []).includes(slug));
    const total = Math.ceil(all.length / PER_PAGE);
    for (let p = 2; p <= total; p++) paths.push({ params: { slug, page: String(p) } });
  }
  return paths;
}

const { slug, page } = Astro.params;
const all = (await getAllRecetas())
  .filter((r) => (r.categorias ?? []).includes(slug!))
  .sort((a, b) => b.id - a.id);
const total = Math.max(1, Math.ceil(all.length / PER_PAGE));
const current = Math.min(Math.max(2, Number(page)), total);
const recetas = all.slice((current - 1) * PER_PAGE, current * PER_PAGE);
const categorias = await getCategorias();
const cat = categorias.find((c) => c.slug === slug);
const nombre = cat?.categoria?.nombre ?? slug!;
---

<Layout title={`${nombre} — página ${current}`}>
  <div class="cards-wrapper">
    <div class="title">
      <h1>{nombre}</h1>
    </div>
    <nav class="cats" aria-label="Categorías">
      {
        categorias.map(({ slug: s, categoria }) => (
          <a href={`/categoria/${s}`} class={`link cat ${s === slug ? "active" : ""}`}>
            {categoria?.nombre}
          </a>
        ))
      }
    </nav>
    <div class="cards">
      {recetas.map((receta) => <Card receta={receta} />)}
    </div>
    <Pagination current={current} total={total} makeHref={(n) => (n <= 1 ? `/categoria/${slug}` : `/categoria/${slug}/${n}`)} />
  </div>
</Layout>

<style>
  .cards-wrapper .title h1 {
    font-size: 32px;
    font-weight: 300;
  }
  .cards-wrapper .title {
    padding-bottom: 8px;
  }
  .cats {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding-bottom: 16px;
  }
  .cat {
    background-color: var(--white);
    border: 1px solid var(--green);
    border-radius: 4px;
    padding: 4px 12px;
    font-size: 14px;
    font-weight: 700;
    color: var(--green);
  }
  .cat.active {
    background-color: var(--green);
    color: var(--white);
  }
  @media only screen and (min-width: 768px) {
    .cards-wrapper .cards {
      display: flex;
      justify-content: space-between;
      flex-wrap: wrap;
    }
  }
</style>
