---
import Layout from "../../components/Layout.astro";
import Card from "../../components/Card.astro";
import { getAllRecetas, getCategorias } from "../../lib/content.js";
import { slugify } from "../../lib/slugify.js";

export async function getStaticPaths() {
  const categorias = await getCategorias();
  return categorias.map(({ slug }) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const recetas = (await getAllRecetas())
  .filter((r) => (r.categorias ?? []).includes(slug!))
  .sort((a, b) => b.id - a.id);
const categorias = await getCategorias();
const current = categorias.find((c) => c.slug === slug);
---

<Layout title={`${current?.categoria?.nombre ?? slug} | BonGusto`}>
  <div class="cards-wrapper">
    <div class="title">
      <h1>{current?.categoria?.nombre ?? slug}</h1>
    </div>
    <nav class="cats">
      {
        categorias.map(({ slug: s, categoria }) => (
          <a href={`/categoria/${s}`} class={`link cat ${s === slug ? "active" : ""}`}>
            {categoria?.nombre}
          </a>
        ))
      }
    </nav>
    {
      recetas.length === 0 ? (
        <p>No hay recetas en esta categoría todavía.</p>
      ) : (
        <div class="cards">
          {recetas.map((receta) => (
            <Card receta={receta} />
          ))}
        </div>
      )
    }
  </div>
</Layout>

<style>
  .cards-wrapper .title h1 {
    font-size: 32px;
    font-weight: 300;
  }
  .cards-wrapper .title {
    padding-bottom: 8px;
  }
  .cats {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding-bottom: 16px;
  }
  .cat {
    background-color: var(--white);
    border: 1px solid var(--green);
    border-radius: 4px;
    padding: 4px 12px;
    font-size: 14px;
    font-weight: 700;
    color: var(--green);
  }
  .cat.active {
    background-color: var(--green);
    color: var(--white);
  }
  @media only screen and (min-width: 768px) {
    .cards-wrapper .cards {
      display: flex;
      justify-content: space-between;
      flex-wrap: wrap;
    }
  }
</style>
