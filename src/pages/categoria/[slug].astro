---
import Layout from "../../components/Layout.astro";
import DeptBanner from "../../components/DeptBanner.astro";
import RecipeGrid from "../../components/RecipeGrid.astro";
import Pagination from "../../components/Pagination.astro";
import { getCategorias, getRecetasByCategoria } from "../../lib/content";
import { PER_PAGE } from "../../lib/paginate";

export async function getStaticPaths() {
  const categorias = await getCategorias();
  return categorias.map(({ slug }) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const all = await getRecetasByCategoria(slug!);
const total = Math.max(1, Math.ceil(all.length / PER_PAGE));
const recetas = all.slice(0, PER_PAGE);
const categorias = await getCategorias();
const nombre = categorias.find((c) => c.slug === slug)?.categoria?.nombre ?? slug!;
const deptNames = new Map(categorias.map(({ slug: s, categoria }) => [s, categoria?.nombre ?? s]));
---

<Layout title={nombre}>
  <DeptBanner nombre={nombre} count={all.length} page={{ current: 1, total }} />
  <div class="wrap">
    {
      all.length === 0 ? (
        <p class="empty">No hay recetas en esta categoría todavía.</p>
      ) : (
        <div class="grid-wrap">
          <RecipeGrid recetas={recetas} deptNames={deptNames} eager={2} heading="Recetas de esta sección" />
        </div>
      )
    }
    <Pagination current={1} total={total} makeHref={(n) => (n <= 1 ? `/categoria/${slug}` : `/categoria/${slug}/${n}`)} />
  </div>
</Layout>

<style>
  .grid-wrap {
    padding-top: 56px;
  }
  .empty {
    padding-block: 64px;
  }
</style>
