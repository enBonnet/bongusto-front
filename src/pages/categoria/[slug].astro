---
import Layout from "../../components/Layout.astro";
import Card from "../../components/Card.astro";
import Pagination from "../../components/Pagination.astro";
import { getCategorias, getRecetasByCategoria } from "../../lib/content.js";
import { PER_PAGE } from "../../lib/paginate.js";

export async function getStaticPaths() {
  const categorias = await getCategorias();
  return categorias.map(({ slug }) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const all = await getRecetasByCategoria(slug!);
const total = Math.max(1, Math.ceil(all.length / PER_PAGE));
const recetas = all.slice(0, PER_PAGE);
const categorias = await getCategorias();
const nombre = categorias.find((c) => c.slug === slug)?.categoria?.nombre ?? slug!;
---

<Layout title={nombre}>
  <div class="cards-wrapper">
    <div class="title">
      <h1>{nombre}</h1>
    </div>
    <nav class="cats" aria-label="Categorías">
      {
        categorias.map(({ slug: s, categoria }) => (
          <a href={`/categoria/${s}`} class={`link cat ${s === slug ? "active" : ""}`}>
            {categoria?.nombre}
          </a>
        ))
      }
    </nav>
    {
      all.length === 0 ? (
        <p>No hay recetas en esta categoría todavía.</p>
      ) : (
        <div class="cards">
          {recetas.map((receta) => (
            <Card receta={receta} />
          ))}
        </div>
      )
    }
    <Pagination current={1} total={total} makeHref={(n) => (n <= 1 ? `/categoria/${slug}` : `/categoria/${slug}/${n}`)} />
  </div>
</Layout>

<style>
  .cards-wrapper .title h1 {
    font-size: 32px;
    font-weight: 300;
  }
  .cards-wrapper .title {
    padding-bottom: 8px;
  }
  .cats {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding-bottom: 16px;
  }
  .cat {
    background-color: var(--white);
    border: 1px solid var(--green);
    border-radius: 4px;
    padding: 4px 12px;
    font-size: 14px;
    font-weight: 700;
    color: var(--green);
  }
  .cat.active {
    background-color: var(--green);
    color: var(--white);
  }
  @media only screen and (min-width: 768px) {
    .cards-wrapper .cards {
      display: flex;
      justify-content: space-between;
      flex-wrap: wrap;
    }
  }
</style>
