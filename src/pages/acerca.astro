---
import Layout from "../components/Layout.astro";
import { getAcerca, renderMarkdoc } from "../lib/content";

const acerca = await getAcerca();
const biografia = renderMarkdoc(acerca?.biografia);
const cursos = renderMarkdoc(acerca?.cursos);
// Cloudinary photos: ask for a sharp square crop instead of the raw upload.
const rawPhoto = acerca?.photo?.url ?? "";
const m = rawPhoto.match(/^(https:\/\/res\.cloudinary\.com\/[^/]+\/image\/upload\/)(.+)$/);
const photo = m ? `${m[1]}f_auto,q_auto,w_1000,h_1000,c_fill,g_face/${m[2]}` : rawPhoto;
---

<Layout title="Acerca de mi">
  <header class="opener">
    {
      photo && (
        <div class="photo">
          <img src={photo} alt={acerca?.photo?.alt || "Antonio Bonnet"} width="1000" height="1000" loading="eager" data-pagefind-ignore />
        </div>
      )
    }
    <div class="panel">
      <p class="flag">Acerca de mí</p>
      <h1>Antonio Bonnet</h1>
      <p class="dek">Maestro en artes culinarias y chef instructor.</p>
    </div>
  </header>

  <div class="wrap body">
    {
      biografia && (
        <section class="bio">
          <h2 class="section-title">Biografía</h2>
          <div class="prose" set:html={biografia} />
        </section>
      )
    }
    {
      cursos && (
        <section class="courses">
          <h2 class="section-title">Cursos</h2>
          <div class="prose" set:html={cursos} />
        </section>
      )
    }
  </div>
</Layout>

<style>
  .opener {
    background-color: var(--aji);
    color: var(--paper);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }
  .photo {
    aspect-ratio: 1 / 1;
    background-color: var(--aji-deep);
    overflow: hidden;
  }
  .photo img {
    height: 100%;
    object-fit: cover;
    width: 100%;
  }
  .panel {
    display: flex;
    flex-direction: column;
    gap: 16px;
    justify-content: flex-end;
    padding: 28px var(--gutter) 40px;
  }
  .flag {
    align-self: flex-start;
    background-color: var(--amarillo);
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-stretch: 100%;
    font-weight: 800;
    letter-spacing: 0.08em;
    padding: 5px 10px;
    text-transform: uppercase;
  }
  h1 {
    font-size: clamp(3.5rem, 10vw, 9rem);
    font-stretch: 62%;
    font-weight: 900;
    letter-spacing: -0.03em;
    line-height: 0.86;
    text-transform: uppercase;
  }
  .dek {
    font-size: 1.5rem;
    line-height: 1.3;
    max-width: 22ch;
  }
  @media (min-width: 900px) {
    .opener {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      min-height: clamp(440px, 62vh, 720px);
    }
    .photo {
      aspect-ratio: auto;
      height: 100%;
    }
    .panel {
      padding: 48px clamp(24px, 4vw, 72px);
    }
  }

  .body {
    display: grid;
    gap: 56px var(--gutter);
    grid-template-columns: minmax(0, 1fr);
    padding-top: 72px;
  }
  .section-title {
    border-top: 3px solid var(--ink);
    font-size: clamp(2rem, 3.4vw, 3rem);
    font-stretch: 62%;
    font-weight: 900;
    margin-bottom: 24px;
    padding-top: 12px;
    text-transform: uppercase;
  }
  .bio .prose > :global(p:first-of-type)::first-letter {
    color: var(--aji);
    float: left;
    font-family: var(--font-display);
    font-size: 5.2em;
    font-stretch: 62%;
    font-weight: 900;
    line-height: 0.78;
    margin: 0.06em 0.1em 0 -0.02em;
  }
  .courses {
    background-color: var(--smoke);
    padding: 24px;
  }
  .courses .section-title {
    border-top-color: var(--aji);
  }
  .courses .prose {
    font-size: 1rem;
    line-height: 1.5;
  }
  @media (min-width: 1000px) {
    .body {
      align-items: start;
      grid-template-columns: minmax(0, 8fr) minmax(280px, 4fr);
    }
    .courses {
      position: sticky;
      top: 24px;
    }
  }
</style>
