---
import Layout from "../../../components/Layout.astro";
import CategoryNav from "../../../components/CategoryNav.astro";
import { getAllRecetas, getCategorias, renderMarkdoc } from "../../../lib/content.js";
import { slugify } from "../../../lib/slugify.js";

export async function getStaticPaths() {
  // Public recipes only — drafts are committed but never rendered publicly.
  const recetas = await getAllRecetas();
  const seen = new Set<number>();
  for (const r of recetas) {
    if (seen.has(r.id)) throw new Error(`duplicate receta id: ${r.id}`);
    seen.add(r.id);
  }
  return recetas.map((receta) => ({
    params: { id: String(receta.id), slug: slugify(receta.titulo) },
    props: { receta },
  }));
}

const { receta } = Astro.props;
const historia = renderMarkdoc(receta.historia);
const ingredientes = renderMarkdoc(receta.ingredientes);
const preparacion = renderMarkdoc(receta.preparacion);
// Chips linking back into browse — a recipe page was previously a dead end.
const categorias = await getCategorias();
const nombreBySlug = new Map(categorias.map(({ slug, categoria }) => [slug, categoria?.nombre ?? slug]));
const chipCats = (receta.categorias ?? []).map((s) => ({ slug: s, nombre: nombreBySlug.get(s) ?? s }));
---

<Layout
  title={receta.titulo.trim()}
  description={receta.descripcion || undefined}
  image={receta.photo?.url || undefined}
  ogType="article"
>
  <article class="receta big-card" data-pagefind-body>
    <h1 class="title" data-pagefind-meta="title">{receta.titulo}</h1>
    {chipCats.length > 0 && <CategoryNav cats={chipCats} />}
    {
      receta.photo?.url && (
        <div class="photo">
          <img
            src={receta.photo.url}
            alt={receta.photo?.alt || receta.titulo}
            width="600"
            data-pagefind-meta="image[src]"
          />
        </div>
      )
    }
    <div class="content">
      {
        historia && (
          <div class="history">
            <h2 class="title">Historia</h2>
            <div class="text" set:html={historia} />
          </div>
        )
      }
      {
        ingredientes && (
          <div class="ingredients">
            <h2 class="title">Ingredientes</h2>
            <div class="text" set:html={ingredientes} />
          </div>
        )
      }
      {
        preparacion && (
          <div class="preparation">
            <h2 class="title">Preparación</h2>
            <div class="text" set:html={preparacion} />
          </div>
        )
      }
    </div>
    <div class="more">
      <a href="/" class="link">Ver más recetas</a>
    </div>
  </article>
</Layout>

<style>
  .receta {
    background-color: var(--white);
    display: flex;
    flex-direction: column;
    justify-content: center;
    border-radius: 4px;
    padding: 8px;
    margin-bottom: 20px;
  }
  .receta .title {
    margin: 0 0 16px;
    font-size: 24px;
    font-weight: 700;
  }
  .receta .photo {
    margin-bottom: 32px;
    overflow: hidden;
    max-width: 600px;
    max-height: 400px;
    align-self: center;
  }
  .receta .photo img {
    max-width: 100%;
    height: auto;
  }
  .receta .history,
  .receta .ingredients,
  .receta .preparation {
    margin-bottom: 32px;
  }
  .receta .history .title,
  .receta .ingredients .title,
  .receta .preparation .title {
    margin: 0 0 16px;
    font-size: 24px;
    font-weight: 700;
  }
  .receta .more {
    text-align: right;
  }
  @media only screen and (min-width: 768px) {
    .receta {
      margin-top: 20px;
    }
  }
</style>
