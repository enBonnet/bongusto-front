---
import Layout from "../components/Layout.astro";
---

<Layout title="Buscar">
  <div class="big-card search-page">
    <h1>Buscar recetas</h1>
    <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
    <script src="/pagefind/pagefind-ui.js" is:inline></script>
    <div id="search"></div>
    <p id="search-unavailable" class="search-unavailable" hidden>
      La búsqueda no está disponible en modo desarrollo: el índice se genera en el build.
      Ejecuta <code>npm run build</code> y luego <code>npm run preview</code> para probarla.
    </p>
    <script is:inline>
      // Name the clicked result's thumbnail after its recipe so the browser can
      // morph it into the photo on the recipe page (see global.css). Pagefind
      // renders results client-side, so this can't be done in markup.
      document.addEventListener("click", (event) => {
        const link = event.target.closest?.(".pagefind-ui__result-link, .pagefind-ui__result-thumb a, .pagefind-ui__result-image");
        const result = link?.closest(".pagefind-ui__result");
        const href = result?.querySelector(".pagefind-ui__result-link")?.getAttribute("href");
        const id = href?.match(/^\/receta\/(\d+)\//)?.[1];
        const thumb = result?.querySelector(".pagefind-ui__result-thumb");
        if (!id || !thumb) return;
        thumb.style.viewTransitionName = `receta-${id}`;
        thumb.style.viewTransitionClass = "receta-photo";
      });
    </script>
    <script is:inline>
      // The pagefind assets only exist after `pagefind --site dist`, so the
      // UI script may 404 under plain `astro dev` — explain instead of
      // leaving a blank card.
      if (!window.PagefindUI) {
        document.getElementById("search-unavailable").hidden = false;
      } else {
        new PagefindUI({ element: "#search", showImages: true, translations: {
          placeholder: "Buscar por título, ingrediente…",
          clear_search: "Limpiar",
          zero_results: "No se encontraron recetas para “[SEARCH_TERM]”",
          many_results: "[COUNT] recetas encontradas para “[SEARCH_TERM]”",
          one_result: "[COUNT] receta encontrada para “[SEARCH_TERM]”",
          searching: "Buscando “[SEARCH_TERM]”…",
          search_for_something_else: "Busca otra cosa",
        }});
      }
    </script>
  </div>
</Layout>

<style>
  .search-page {
    background-color: var(--white);
    border-radius: 4px;
    padding: 16px;
    margin-top: 20px;
  }
  .search-page h1 {
    font-size: 32px;
    font-weight: 300;
  }
  .search-unavailable {
    color: #6f6f6f;
    margin-top: 16px;
  }
</style>
