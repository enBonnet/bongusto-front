---
import type { Receta } from "../lib/content";
import { recetaCardImage, recetaImageSrcset, recetaUrl } from "../lib/content";

interface Props {
  receta: Receta;
  /** Department (category) label shown above the headline. */
  dept?: string;
  /** Column span out of 12 on the desktop grid; 12 renders the horizontal band. */
  span?: number;
  /** Load the photo eagerly (first row above the fold). */
  eager?: boolean;
}
const { receta, dept, span = 4, eager = false } = Astro.props;
const variant = span === 12 ? "band" : span >= 7 ? "large" : span === 5 ? "side" : "standard";
const srcset = recetaImageSrcset(receta);
// Width of the photo on desktop as a share of the viewport, so the browser
// picks the smallest candidate that stays sharp.
const desktopVw = span === 12 ? 58 : Math.round((span / 12) * 100);
const sizes = `(min-width: 900px) ${Math.min(desktopVw, 100)}vw, 100vw`;
---

<a href={recetaUrl(receta)} class={`link story ${variant}`} style={`--span: ${span}`}>
  {receta.photo?.url && (
    <div class="photo" style={`view-transition-name: receta-${receta.id}`}>
      <img
        src={recetaCardImage(receta)}
        srcset={srcset}
        sizes={srcset ? sizes : undefined}
        alt={receta.photo?.alt || receta.titulo}
        loading={eager ? "eager" : "lazy"}
        decoding="async"
        width="600"
        height="450"
        data-pagefind-ignore
      />
    </div>
  )}
  <div class="text">
    {dept && <p class="kicker">{dept}</p>}
    <h3 class="title">{receta.titulo}</h3>
    <p class="dek">{receta.descripcion}</p>
  </div>
</a>

<style>
  .story {
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-width: 0;
  }
  .photo {
    aspect-ratio: 4 / 3;
    background-color: var(--smoke);
    overflow: hidden;
    view-transition-class: receta-photo;
  }
  .photo img {
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s var(--ease-out);
    width: 100%;
  }
  .story:hover .photo img,
  .story:focus-visible .photo img {
    transform: scale(1.04);
  }
  .text {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .title {
    font-size: clamp(1.75rem, 2.4vw, 2.25rem);
    font-stretch: 68%;
    font-weight: 800;
    line-height: 0.95;
  }
  .story:hover .title {
    color: var(--aji);
  }
  .dek {
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    color: var(--muted);
    display: -webkit-box;
    font-size: 1.0625rem;
    line-height: 1.5;
    overflow: hidden;
  }

  .large .title {
    font-size: clamp(2.25rem, 4vw, 3.75rem);
    font-weight: 900;
  }
  .large .dek {
    font-size: 1.1875rem;
    max-width: 52ch;
  }

  @media (min-width: 900px) {
    .story {
      grid-column: span var(--span);
    }
    /* Beside a large story: the photo takes the row's leftover height. */
    .side .photo {
      aspect-ratio: auto;
      flex: 1 1 auto;
      min-height: 280px;
    }
    .band {
      align-items: stretch;
      background-color: var(--smoke);
      flex-direction: row;
      gap: 0;
    }
    .band .photo {
      aspect-ratio: auto;
      flex: 7 1 0;
      min-height: 340px;
    }
    .band .text {
      flex: 5 1 0;
      gap: 16px;
      justify-content: center;
      padding: clamp(24px, 3.6vw, 56px);
    }
    .band .title {
      font-size: clamp(2.5rem, 4.4vw, 4.25rem);
      font-weight: 900;
    }
    .band .dek {
      color: var(--ink);
    }
    .band .kicker {
      color: var(--aji-deep);
    }
  }
</style>
