---
import "@fontsource/raleway/300.css";
import "@fontsource/raleway/400.css";
import "@fontsource/raleway/700.css";
import "../styles/global.css";
import { SITE } from "../lib/site";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  ogType?: "website" | "article";
}
const {
  title = "BonGusto",
  description = SITE.description,
  image = SITE.image,
  canonical,
  ogType = "website",
} = Astro.props;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
const fullTitle = title === "BonGusto" ? title : `${title} | BonGusto`;
// og/twitter require absolute URLs; SITE.image may be site-relative.
const imageUrl = image ? new URL(image, Astro.site).href : undefined;
// Raleway is self-hosted via @fontsource (imports above): the woff2 files are
// bundled into /_astro/ and served from this origin with immutable caching —
// no render-blocking third-party request, no Google connection.
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/png" href="/bongusto-rounded.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="BonGusto" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {image && <meta property="og:image" content={imageUrl} />}
    <meta name="twitter:card" content={image ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {image && <meta name="twitter:image" content={imageUrl} />}
    <!-- Pages can inject head-only tags (e.g. JSON-LD) through this slot. -->
    <slot name="head" />
  </head>
  <body>
    <header class="header">
      <nav class="nav">
        <a href="/" class="link logo">BonGusto</a>
        <div class="menu">
          <a href="/buscar" class="link">Buscar</a>
          <a href="/acerca" class="link">Acerca de mi</a>
        </div>
      </nav>
    </header>
    <main class="main">
      <slot />
    </main>
    <footer class="footer">
      <div class="mobile">
        <a href="/buscar" class="link option">Buscar</a>
        <a href="/acerca" class="link option">Acerca de mi</a>
      </div>
    </footer>
  </body>
</html>

<style>
  .header {
    background-color: var(--white);
    border-bottom: 1px solid var(--green);
    padding: 16px 8px;
  }
  .header .nav {
    display: flex;
    justify-content: space-between;
  }
  .header .logo {
    color: var(--green);
    font-size: 18px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
  }
  .header .menu {
    font-weight: 700;
  }
  @media only screen and (max-width: 767px) {
    .header .menu {
      display: none;
    }
  }

  .footer {
    align-items: center;
    background-color: var(--white);
    border-top: 1px solid var(--green);
    bottom: 0;
    justify-content: flex-end;
    position: fixed;
    width: 100%;
  }
  .footer .mobile {
    align-items: center;
    display: flex;
    font-weight: 700;
    height: 40px;
    justify-content: left;
  }
  .footer .option {
    margin: 0 8px;
  }
  @media only screen and (min-width: 768px) {
    .footer {
      display: none;
    }
  }
</style>
