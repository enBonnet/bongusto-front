---
// Fake search input: an <a> styled like a text field. A link (not a real
// <input>) is honest about the behavior — it can't be typed into — while
// staying clickable, keyboard-focusable and functional without JS.
---

<a href="/buscar" class="search-trigger">
  <svg
    class="icon"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2.5"
    stroke-linecap="square"
    aria-hidden="true"
  >
    <circle cx="11" cy="11" r="7"></circle>
    <line x1="16.5" y1="16.5" x2="21" y2="21"></line>
  </svg>
  <span class="placeholder">Buscar por título, ingrediente…</span>
</a>

<style>
  .search-trigger {
    align-items: center;
    border-bottom: 3px solid var(--ink);
    color: var(--muted);
    display: flex;
    gap: 10px;
    padding: 8px 2px;
    text-decoration: none;
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .search-trigger:hover,
  .search-trigger:focus-visible {
    border-color: var(--aji);
    color: var(--ink);
  }
  .search-trigger .icon {
    flex-shrink: 0;
    height: 20px;
    width: 20px;
  }
  .search-trigger .placeholder {
    font-size: 1.0625rem;
  }
</style>
