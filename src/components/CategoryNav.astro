---
/**
 * Department kickers above a recipe headline: the recipe's own categories as
 * links back into browse. Only that recipe's categories are passed in.
 */
interface Props {
  cats: { slug: string; nombre: string }[];
}
const { cats } = Astro.props;
---

<nav class="cats" aria-label="Categoría de la receta">
  {
    cats.map(({ slug, nombre }) => (
      <a href={`/categoria/${slug}`} class="link kicker cat">
        {nombre}
      </a>
    ))
  }
</nav>

<style>
  .cats {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
  }
  .cat {
    font-size: 0.875rem;
    /* ≥24px tall click target for a 14px kicker link. */
    padding-block: 4px;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
  }
  .cat:hover {
    color: var(--aji-deep);
  }
</style>
