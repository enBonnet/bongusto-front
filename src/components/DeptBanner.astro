---
/** Full-bleed Ají banner that opens a department (category) or index page. */
interface Props {
  nombre: string;
  /** Small label above the title. */
  flag?: string;
  count?: number;
  /** Shown as "Página N de T" when the department spans several pages. */
  page?: { current: number; total: number };
}
const { nombre, flag = "Sección", count, page } = Astro.props;
---

<header class="banner">
  <div class="wrap">
    <p class="flag">{flag}</p>
    <h1>{nombre}</h1>
    {
      count !== undefined && (
        <p class="meta">
          {count} {count === 1 ? "receta" : "recetas"}
          {page && page.total > 1 && <span> · Página {page.current} de {page.total}</span>}
        </p>
      )
    }
  </div>
</header>

<style>
  .banner {
    background-color: var(--aji);
    color: var(--paper);
    padding-block: 40px 36px;
  }
  .flag {
    background-color: var(--amarillo);
    color: var(--ink);
    display: inline-block;
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-stretch: 100%;
    font-weight: 800;
    letter-spacing: 0.08em;
    padding: 5px 10px;
    text-transform: uppercase;
  }
  h1 {
    font-size: clamp(4rem, 17vw, 15rem);
    font-stretch: 62%;
    font-weight: 900;
    letter-spacing: -0.03em;
    line-height: 0.84;
    margin-block: 10px 0;
    text-transform: uppercase;
  }
  .meta {
    margin-top: 18px;
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-stretch: 100%;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
</style>
