---
import type { Receta } from "../lib/content";
import { recetaCardImage, recetaImageSrcset, recetaUrl } from "../lib/content";

interface Props {
  receta: Receta;
  dept?: string;
}
const { receta, dept } = Astro.props;
const srcset = recetaImageSrcset(receta);
---

<a href={recetaUrl(receta)} class="link cover">
  {receta.photo?.url && (
    <div class="photo" style={`view-transition-name: receta-${receta.id}`}>
      <img
        src={recetaCardImage(receta)}
        srcset={srcset}
        sizes={srcset ? "(min-width: 900px) 66vw, 100vw" : undefined}
        alt={receta.photo?.alt || receta.titulo}
        loading="eager"
        fetchpriority="high"
        decoding="async"
        width="1600"
        height="1200"
        data-pagefind-ignore
      />
    </div>
  )}
  <div class="panel">
    <p class="flag">Receta del número</p>
    {dept && <p class="dept">{dept}</p>}
    <h2 class="title">{receta.titulo}</h2>
    <p class="dek">{receta.descripcion}</p>
    <p class="go">Leer la receta <span aria-hidden="true">→</span></p>
  </div>
</a>

<style>
  .cover {
    background-color: var(--aji);
    color: var(--paper);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }
  .photo {
    aspect-ratio: 4 / 3;
    background-color: var(--aji-deep);
    overflow: hidden;
    view-transition-class: receta-photo;
  }
  .photo img {
    animation: cover-in 1.1s var(--ease-out) both;
    height: 100%;
    object-fit: cover;
    transition: transform 0.9s var(--ease-out);
    width: 100%;
  }
  .cover:hover .photo img,
  .cover:focus-visible .photo img {
    transform: scale(1.03);
  }
  .panel {
    display: flex;
    flex-direction: column;
    gap: 16px;
    justify-content: flex-end;
    padding: 28px var(--gutter) 36px;
  }
  .flag {
    background-color: var(--amarillo);
    color: var(--ink);
    align-self: flex-start;
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-stretch: 100%;
    font-weight: 800;
    letter-spacing: 0.08em;
    padding: 5px 10px;
    text-transform: uppercase;
  }
  .dept {
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-stretch: 100%;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .title {
    font-size: clamp(2.75rem, 7.4vw, 6.5rem);
    font-stretch: 62%;
    font-weight: 900;
    line-height: 0.88;
  }
  .dek {
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;
    display: -webkit-box;
    font-size: 1.25rem;
    font-style: italic;
    line-height: 1.4;
    overflow: hidden;
  }
  .go {
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-stretch: 100%;
    font-weight: 800;
    letter-spacing: 0.08em;
    margin-top: 8px;
    text-transform: uppercase;
  }
  .cover:hover .go {
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .cover:focus-visible {
    outline-color: var(--ink);
    outline-offset: -6px;
  }

  @media (min-width: 900px) {
    .cover {
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
      min-height: clamp(460px, 64vh, 760px);
    }
    .photo {
      aspect-ratio: auto;
      height: 100%;
    }
    .panel {
      justify-content: flex-start;
      padding: 36px clamp(24px, 2.6vw, 44px);
    }
    .go {
      margin-top: auto;
    }
  }

  @keyframes cover-in {
    from {
      clip-path: inset(0 0 0 100%);
      transform: scale(1.08);
    }
    to {
      clip-path: inset(0);
      transform: scale(1);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .photo img {
      animation: none;
    }
  }
</style>
