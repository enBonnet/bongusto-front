---
import { buildRun } from "../lib/paginate";

interface Props {
  current: number; // 1-based
  total: number;
  /** Where page N lives. Defaults to the global recipe pagination. */
  makeHref?: (page: number) => string;
}
const { current, total, makeHref = (n) => (n <= 1 ? "/" : `/pagina/${n}`) } = Astro.props;

// Condensed numeral run for the center slot: 1 … 5 6 7 … 21 (all pages when
// they fit). Real links, current page marked with aria-current.
const run = buildRun(current, total);
---

{
  total > 1 && (
    <nav class="pagination" aria-label="Paginación">
      {current > 1 ? (
        <a href={makeHref(current - 1)} class="link step prev" rel="prev">
          <span class="arrow" aria-hidden="true">←</span>
          <span class="label">Anterior</span>
        </a>
      ) : (
        <span class="step prev off" aria-hidden="true" />
      )}
      <div class="status">
        <p class="sr-only">Página {current} de {total}</p>
        {run.map((p) =>
          p === "gap" ? (
            <span class="dots" aria-hidden="true">
              …
            </span>
          ) : p === current ? (
            <strong aria-current="page">{p}</strong>
          ) : (
            <a class="link" href={makeHref(p)}>{p}</a>
          ),
        )}
      </div>
      {current < total ? (
        <a href={makeHref(current + 1)} class="link step next" rel="next">
          <span class="label">Siguiente</span>
          <span class="arrow" aria-hidden="true">→</span>
        </a>
      ) : (
        <span class="step next off" aria-hidden="true" />
      )}
    </nav>
  )
}

<style>
  .pagination {
    align-items: stretch;
    border-top: 3px solid var(--ink);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    margin-top: 72px;
  }
  .step {
    align-items: center;
    display: flex;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 3vw, 2.25rem);
    font-stretch: 70%;
    font-weight: 900;
    gap: 12px;
    padding-block: 20px;
    text-transform: uppercase;
  }
  .step.next {
    justify-content: flex-end;
  }
  .step:not(.off):hover {
    color: var(--aji);
  }
  .arrow {
    font-stretch: 100%;
  }
  .status {
    align-items: baseline;
    display: flex;
    flex-wrap: wrap;
    font-family: var(--font-display);
    gap: 4px 8px;
    justify-content: center;
    padding-inline: 16px;
  }
  .status a,
  .status strong {
    font-size: 1.125rem;
    font-stretch: 70%;
    font-weight: 800;
    /* ≥24px click targets (WCAG 2.5.8) for the condensed numerals. */
    min-height: 24px;
    min-width: 24px;
    padding: 4px;
  }
  .status a:hover {
    color: var(--aji);
  }
  .status strong {
    /* Ink underline: the current page keeps a non-color cue and never reads
       as a hover state. */
    border-bottom: 3px solid var(--ink);
    color: var(--aji);
  }
  .dots {
    color: var(--muted);
  }
  /* Step labels collapse to arrows on narrow screens (still announced); the
     numeral run stays visible and wraps. */
  @media (max-width: 520px) {
    .label {
      clip-path: inset(50%);
      height: 1px;
      overflow: hidden;
      position: absolute;
      white-space: nowrap;
      width: 1px;
    }
  }
</style>
