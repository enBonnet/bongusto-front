---
/** Rule + condensed section title, optional right-hand slot (search, count…). */
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<div class="section-head">
  <h2>{title}</h2>
  <div class="aside"><slot /></div>
</div>

<style>
  .section-head {
    align-items: end;
    border-top: 3px solid var(--ink);
    display: flex;
    flex-wrap: wrap;
    gap: 16px 32px;
    justify-content: space-between;
    margin: 72px 0 32px;
    padding-top: 14px;
  }
  h2 {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-stretch: 62%;
    font-weight: 900;
    text-transform: uppercase;
  }
  .aside {
    flex: 0 1 26rem;
    min-width: 240px;
  }
</style>
