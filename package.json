{
  "name": "bongusto",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Recetas de comida latinoamericana con un poco de historia — blog estático con CMS embebido (Astro + Keystatic)",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "node scripts/preview.mjs",
    "recover": "node scripts/recover-recetas.mjs",
    "transform": "node scripts/transform-raw.mjs",
    "verify:reader": "tsx scripts/verify-reader.mts",
    "audit:redirects": "node scripts/check-redirects.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@astrojs/netlify": "^8.2.9",
    "@astrojs/react": "^7.0.1",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/raleway": "^5.3.0",
    "@keystatic/astro": "^6.0.0",
    "@keystatic/core": "^0.6.9",
    "@markdoc/markdoc": "^0.5.10",
    "@netlify/blobs": "^11.1.4",
    "astro": "^7.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "pagefind": "^1.5.2",
    "tsx": "^4.23.15",
    "vitest": "^4.1.11"
  }
}
